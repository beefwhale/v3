{
    "routes": [
      {
        "src": "^/v1/?$",
        "dest": "https://beefwhale.github.io/v1/"
      },
      {
        "src": "^/v1/(.*)$",
        "dest": "https://beefwhale.github.io/v1/$1"
      },
      {
        "src": "^/v2/?$",
        "dest": "https://beefwhale.github.io/v2/"
      },
      {
        "src": "^/v2/(.*)$",
        "dest": "https://beefwhale.github.io/v2/$1"
      },
      {
        "handle": "filesystem"
      }
    ]
  }
